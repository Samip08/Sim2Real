<?xml version="1.0"?>
<!-- Sim2Real robot description.
     base_link = centre of the wheel axle, x forward, y left, z up. -->
<robot name="postman_bot">

  <link name="base_link">
    <inertial>
      <origin xyz="0.095 0 0.0135" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.001565" iyy="0.002994" izz="0.003716" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- Rotated 180 deg around Z: rpy=(pi/2, 0, pi/2), origin preserves footprint X in [-0.010, 0.204] -->
      <origin xyz="0.119 0 -0.0164" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="package://postman_pkg/meshes/chassis_body.stl"/></geometry>
      <material name="body_gray"><color rgba="0.55 0.60 0.68 1"/></material>
    </visual>
    <visual>
      <!-- Rotated 180 deg around Z, flush on body rim at Z=0.0535m -->
      <origin xyz="0.1192 0 -0.0185" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="package://postman_pkg/meshes/chassis_lid.stl"/></geometry>
      <material name="lid_gray"><color rgba="0.42 0.46 0.52 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.095 0 0.0135" rpy="0 0 0"/>
      <geometry><box size="0.21 0.14 0.085"/></geometry>
    </collision>
  </link>

  <link name="left_wheel">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="2.67e-5" iyy="5.06e-5" izz="2.67e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- Mesh radius=0.0225m; scale=1 matches collision cylinder r=0.0225m -->
      <origin rpy="0 0 1.5708"/>
      <geometry><mesh filename="package://postman_pkg/meshes/left_wheel.stl" scale="1 1 1"/></geometry>
      <material name="wheel_black"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <collision>
      <origin rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.0225" length="0.018"/></geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.0795 -0.020"/><axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="2.67e-5" iyy="5.06e-5" izz="2.67e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- Mesh radius=0.0225m; scale=1 matches collision cylinder r=0.0225m -->
      <origin rpy="0 0 1.5708"/>
      <geometry><mesh filename="package://postman_pkg/meshes/right_wheel.stl" scale="1 1 1"/></geometry>
      <material name="wheel_black"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <collision>
      <origin rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.0225" length="0.018"/></geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.0795 -0.020"/><axis xyz="0 1 0"/>
  </joint>

  <!-- Ball caster, frictionless -->
  <link name="caster">
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="2e-6" iyy="2e-6" izz="2e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual><geometry><sphere radius="0.01"/></geometry></visual>
    <collision><geometry><sphere radius="0.01"/></geometry></collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/>
    <origin xyz="0.190 0 -0.0325"/>
  </joint>

  <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <!-- ================================================================
       Gazebo Harmonic (gz-sim 8) plugins
       ================================================================ -->

  <!-- 1. Differential-drive: /cmd_vel -> wheel torques.
       odom_topic is renamed to an internal Gz topic so it is NEVER bridged
       to ROS.  Participants must compute /odom themselves from /joint_states
       (wheel encoder velocities) and /imu (gyroscope + accelerometer).
       wheel_separation = 2 * 0.0795 m = 0.159 m
       wheel_radius     = 0.0225 m                                         -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.159</wheel_separation>
      <wheel_radius>0.0225</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <!-- Internal topic — not bridged to ROS intentionally -->
      <odom_topic>/gz/odom_internal</odom_topic>
      <!-- TF suppressed: teams must broadcast odom->base_link from their node -->
      <tf_topic>/gz/tf_internal</tf_topic>
      <frame_id>odom</frame_id>
      <!-- Hard actuator limits enforced by simulation physics -->
      <min_linear_velocity>0.0</min_linear_velocity>
      <max_linear_velocity>0.3</max_linear_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
    </plugin>
  </gazebo>

  <!-- 2. Joint-state publisher: /joint_states so robot_state_publisher
          can broadcast wheel TFs to RViz.                             -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- 3. IMU sensor attached to base_link.
          gz-sim-imu-system is already loaded in arena.sdf.
          bridge.yaml routes /imu -> ROS sensor_msgs/Imu.            -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
